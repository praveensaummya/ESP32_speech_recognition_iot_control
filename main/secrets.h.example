/**
 * @file secrets.h.example
 * @brief TEMPLATE for local MQTT credentials — copy to main/secrets.h
 *
 * WHY: broker credentials must never be committed to git (the repo is
 * shared). Each developer keeps their own copy of this file locally.
 *
 * SETUP (one time, after cloning):
 *   cp main/secrets.h.example main/secrets.h
 *   ...then edit main/secrets.h with YOUR broker credentials.
 *
 * main/secrets.h is listed in .gitignore so it stays local to your machine.
 * If secrets.h is absent, the project still compiles but the device falls
 * back to placeholder credentials and MQTT will NOT connect until real
 * credentials are pushed to the device via POST /api/config/mqtt (or NVS).
 */

#pragma once

/** Cloud MQTT broker URI (mqtts:// = TLS, port 8883 implied for HiveMQ Cloud). */
#define MQTT_DEFAULT_BROKER_URI    "mqtts://YOUR-CLUSTER-ID.s1.eu.hivemq.cloud"

/** Broker username. */
#define MQTT_DEFAULT_BROKER_USER   "your-username"

/** Broker password — treated as a secret, never logged or published. */
#define MQTT_DEFAULT_BROKER_PASS   "your-password"
